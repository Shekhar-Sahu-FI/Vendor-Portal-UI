BASE_URL=http://localhost:5173
# Must match your running backend (e.g. http://192.168.0.35:5000). If down, tests fall back to UI login.
API_BASE_URL=http://localhost:5000
TEST_USERNAME=your.username
TEST_PASSWORD=
USER_PORTAL=company

# Auth (default: fresh API login each run, delete auth.json after run)
# PW_REUSE_AUTH=1              # reuse auth.json if still valid (faster repeat runs)
# PW_AUTH_CLEANUP=delete       # delete auth.json after run (default)
# PW_AUTH_CLEANUP=refresh      # rewrite auth.json with new login after run
# PW_AUTH_MODE=ui              # skip API; login only through BASE_URL (frontend must be up)
# PW_SKIP_AUTH=1               # skip global setup/teardown auth
# PW_WORKERS=1                 # parallel workers (default 1 locally for fast startup)

