{
  "name": "automations",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:fast": "playwright test --workers=1",
    "report:show": "playwright show-report",
    "test:pr": "playwright test tests/purchase-request",
    "test:pr:save": "playwright test tests/purchase-request/purchase-request.save.spec.ts",
    "test:pr:update": "playwright test tests/purchase-request/purchase-request.update.spec.ts",
    "test:pr:verify": "playwright test tests/purchase-request/purchase-request.verify-saved.spec.ts --workers=1",
    "test:pr:delete": "playwright test tests/purchase-request/purchase-request.delete.spec.ts",
    "test:rfq": "playwright test tests/request-for-quotation --workers=1",
    "test:rfq:direct": "playwright test tests/request-for-quotation/request-for-quotation.save.spec.ts --grep \"Direct source document\" --workers=1",
    "test:rfq:validation": "playwright test tests/request-for-quotation/request-for-quotation.validation.spec.ts --workers=1 --headed",
    "test:rfq:limits": "playwright test tests/request-for-quotation/request-for-quotation.limits.spec.ts --workers=1",
    "test:rfq:attachments": "playwright test tests/request-for-quotation/request-for-quotation.attachments.spec.ts --workers=1",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:po": "playwright test tests/purchase-order",
    "test:po:save": "playwright test tests/purchase-order/purchase-order.save.spec.ts",
    "test:po:update": "playwright test tests/purchase-order/purchase-order.update.spec.ts",
    "test:po:delete": "playwright test tests/purchase-order/purchase-order.delete.spec.ts",
    "test:po:bulk-pr": "playwright test tests/purchase-order/purchase-order.bulk-from-pr.spec.ts --workers=1",
    "test:po:bulk-pr:headed": "playwright test tests/purchase-order/purchase-order.bulk-from-pr.spec.ts --workers=1 --headed",
    "test:asm": "playwright test tests/approval-setup-master --workers=1",
    "test:asm:save": "playwright test tests/approval-setup-master/approval-setup-master.save.spec.ts --workers=1",
    "test:asm:update": "playwright test tests/approval-setup-master/approval-setup-master.update.spec.ts --workers=1",
    "test:asm:delete": "playwright test tests/approval-setup-master/approval-setup-master.delete.spec.ts --workers=1",
    "test:im": "playwright test tests/item-master --workers=1",
    "test:im:save": "playwright test tests/item-master/item-master.save.spec.ts --workers=1",
    "auth:setup": "playwright test tests/auth.setup.ts --config=playwright.auth.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "dotenv": "^16.6.1"
  }
}
